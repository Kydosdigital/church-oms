# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used in trusted server contexts (never exposed to the browser) — e.g.
# scripts, admin tooling. Not required for the app itself, which relies on RLS.
SUPABASE_SERVICE_ROLE_KEY=

# App-level defaults, used until per-church settings are configured.
NEXT_PUBLIC_APP_NAME="Church Operations"
