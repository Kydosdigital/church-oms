# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used in trusted server contexts (never exposed to the browser) — e.g.
# scripts, admin tooling. Not required for the app itself, which relies on RLS.
SUPABASE_SERVICE_ROLE_KEY=

# App-level defaults, used until per-church settings are configured.
NEXT_PUBLIC_APP_NAME="Church Operations"

# Optional error monitoring (Sentry). Leave unset and the app runs exactly as
# before — see src/instrumentation.ts, src/instrumentation-client.ts.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps during `next build` (nicer stack traces
# in Sentry); the build succeeds without it either way.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Marketing site contact form. Any endpoint that accepts a JSON POST works —
# Formspree, a Zapier/Make catch hook, a Slack incoming webhook, or your own
# handler. With this unset the form tells visitors to email instead of
# silently discarding their message.
CONTACT_WEBHOOK_URL=
