{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env*.local)",
      "Bash(cat *.env*)",
      "Bash(*SUPABASE_SERVICE_ROLE_KEY*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-env.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-before-commit.sh"
          }
        ]
      }
    ]
  }
}
